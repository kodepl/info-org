---
import "../styles/global.css";
import site, { deskSlug } from "../site.config";
import EmailLink from "../components/EmailLink.astro";
const { title, description = site.tagline, image = site.heroImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const now = new Date().toLocaleString("pl-PL", {
  weekday: "short",
  day: "numeric",
  month: "short",
  hour: "2-digit",
  minute: "2-digit",
});
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>if(location.hostname.indexOf("www.")!==0 && location.hostname.endsWith("info.org.pl")){location.replace(location.href.replace("://","://www."));}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} · ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="pl_PL" />
    <meta name="robots" content="index,follow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=Oswald:wght@400;500;600;700&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-desk font-body text-chalk antialiased">
    <div class="border-b border-beam/20 bg-panel">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2 text-[11px] font-mono uppercase tracking-[0.16em] text-mute">
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center gap-1.5 rounded bg-signal px-2 py-0.5 font-semibold text-white">
            <span class="live-dot inline-block h-1.5 w-1.5 rounded-full bg-white"></span>
            LIVE
          </span>
          <span class="hidden sm:inline">Studio informacyjne · {site.city}</span>
        </div>
        <time>{now}</time>
      </div>
    </div>

    <header class="border-b border-white/10 bg-gradient-to-b from-panel to-desk">
      <div class="mx-auto flex max-w-7xl flex-wrap items-end justify-between gap-4 px-4 py-5">
        <a href="/" class="group">
          <p class="font-mono text-[10px] uppercase tracking-[0.35em] text-beam">serwis informacyjny</p>
          <p class="font-display text-4xl font-bold tracking-tight text-chalk md:text-5xl">
            INFO<span class="text-signal">.</span>ORG<span class="text-beam">.PL</span>
          </p>
          <p class="mt-1 max-w-md text-sm text-mute">{site.tagline}</p>
        </a>
        <nav class="flex flex-wrap gap-1 text-xs font-semibold uppercase tracking-wider">
          <a href="/" class="rounded px-3 py-2 hover:bg-white/5 hover:text-beam">Studio</a>
          <a href="/live/" class="rounded px-3 py-2 text-signal hover:bg-signal/10">Na żywo</a>
          <a href="/wiadomosci/" class="rounded px-3 py-2 hover:bg-white/5 hover:text-beam">Wiadomości</a>
          <a href="/deski/" class="rounded px-3 py-2 hover:bg-white/5 hover:text-beam">Deski</a>
          <a href="/redakcja/" class="rounded px-3 py-2 hover:bg-white/5 hover:text-beam">Redakcja</a>
          <a href="/kontakt/" class="rounded px-3 py-2 hover:bg-white/5 hover:text-beam">Kontakt</a>
        </nav>
      </div>
      <div class="overflow-hidden border-t border-beam/20 bg-black/40">
        <div class="ticker-track flex w-max gap-10 whitespace-nowrap py-2 font-mono text-xs uppercase tracking-widest text-beam/90">
          {[...site.ticker, ...site.ticker].map((item) => (
            <span>◆ {item}</span>
          ))}
        </div>
      </div>
    </header>

    <slot />

    <footer class="mt-16 border-t border-white/10 bg-panel">
      <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 md:grid-cols-3">
        <div>
          <p class="font-display text-2xl tracking-wide">{site.shortName}</p>
          <p class="mt-2 text-sm text-mute">{site.address}</p>
          <p class="mt-1 text-sm"><EmailLink /></p>
        </div>
        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-mute">Deski tematyczne</p>
          <ul class="mt-3 space-y-1 text-sm">
            {site.desks.map((d) => (
              <li><a class="hover:text-beam" href={`/deski/${deskSlug(d.name)}/`}>{d.name}</a></li>
            ))}
          </ul>
        </div>
        <div class="text-sm text-mute">
          <p>To nie jest portal z 40 banerami pod leadem. Teksty, streamy i kontekst — bez udawania, że jesteśmy telewizją z budżetem ministerstwa.</p>
          <p class="mt-4"><a href="/polityka-prywatnosci/" class="underline hover:text-beam">Prywatność</a> · <a href="/regulamin/" class="underline hover:text-beam">Regulamin</a></p>
          <p class="mt-2">© {new Date().getFullYear()} {site.name}</p>
        </div>
      </div>
    </footer>
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"2b9e3d834d6048f9882b0d1e2e1bba2e"}'></script>
  </body>
</html>
