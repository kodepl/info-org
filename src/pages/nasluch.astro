---
import Broadcast from "../layouts/Broadcast.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("wiadomosci")).sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));
const items = posts.map((post) => ({
  title: post.data.title,
  category: post.data.category || "",
  description: post.data.description || "",
  href: "/wiadomosci/" + post.slug + "/",
}));
---
<Broadcast title="Nasłuch archiwum" description="Wyszukiwanie po tytułach i deskach INFO.ORG.PL.">
  <section class="mx-auto max-w-3xl px-4 py-14">
    <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-beam">Archiwum</p>
    <h1 class="mt-2 font-display text-4xl tracking-wide">Nasłuch</h1>
    <p class="mt-3 text-mute">Hasło z tytułu, deski lub opisu. Wyniki liczone lokalnie, bez wysyłki na serwer.</p>
    <input
      id="q-info-org"
      class="mt-6 w-full border border-white/15 bg-panel px-4 py-3 text-base text-chalk outline-none ring-beam/40 placeholder:text-mute focus:ring-1"
      type="search"
      placeholder="np. kolej, alert, inflacja…"
      autocomplete="off"
    />
    <p id="n-info-org" class="mt-3 font-mono text-xs uppercase tracking-widest text-mute"></p>
    <ul id="list-info-org" class="mt-6 divide-y divide-white/10 border border-white/10 bg-panel/40"></ul>
  </section>
</Broadcast>
<script define:vars={{ items, repo: "info-org" }}>
  const input = document.getElementById("q-" + repo);
  const list = document.getElementById("list-" + repo);
  const note = document.getElementById("n-" + repo);
  function esc(s) {
    return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
  }
  function draw() {
    const q = input.value.trim().toLowerCase();
    const found = items.filter((item) =>
      (item.title + " " + item.category + " " + item.description).toLowerCase().includes(q)
    );
    note.textContent = found.length + " pozycji";
    list.innerHTML = found
      .slice(0, 50)
      .map(
        (item) =>
          '<li class="px-4 py-4"><a class="block hover:text-beam" href="' +
          esc(item.href) +
          '"><span class="font-mono text-[10px] uppercase tracking-widest text-beam">' +
          esc(item.category) +
          '</span><span class="mt-1 block font-display text-2xl tracking-wide text-chalk">' +
          esc(item.title) +
          "</span></a></li>"
      )
      .join("");
  }
  input.addEventListener("input", draw);
  draw();
</script>
