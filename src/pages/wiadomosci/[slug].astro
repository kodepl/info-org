---
import Broadcast from "../../layouts/Broadcast.astro";
import { getCollection } from "astro:content";
import site, { coverFor } from "../../site.config";

export async function getStaticPaths() {
  const posts = await getCollection("wiadomosci");
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const cover = coverFor(post.data.category, post.data.image);
const date = post.data.pubDate.toLocaleDateString("pl-PL", { day: "numeric", month: "long", year: "numeric" });
---
<Broadcast title={post.data.title} description={post.data.description} image={cover}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-signal">{post.data.category} · {date}</p>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-wide md:text-5xl">{post.data.title}</h1>
    <p class="mt-4 text-lg text-mute">{post.data.description}</p>
    <div class="mt-4 flex items-center gap-3 text-sm text-mute">
      <img src={site.authorAvatar} alt="" class="h-10 w-10 rounded-full object-cover ring-1 ring-beam/40" />
      <div>
        <p class="font-semibold text-chalk">{post.data.author || site.author}</p>
        <p class="text-xs">{post.data.authorBio || site.authorBio}</p>
      </div>
    </div>
    <img src={cover} alt="" class="mt-8 aspect-[16/9] w-full rounded-lg object-cover ring-1 ring-white/10" />

    {post.data.youtubeId && (
      <div class="mt-8 overflow-hidden rounded-xl border border-beam/30 bg-black shadow-glow">
        <div class="border-b border-white/10 bg-panel px-3 py-2 font-mono text-[10px] uppercase tracking-widest text-signal">
          <span class="live-dot mr-2 inline-block h-2 w-2 rounded-full bg-signal"></span>
          Materiał wideo
        </div>
        <div class="aspect-video">
          <iframe
            class="h-full w-full"
            src={`https://www.youtube.com/embed/${post.data.youtubeId}`}
            title="Materiał wideo do artykułu"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    )}

    <div class="prose prose-invert prose-headings:font-display prose-headings:tracking-wide prose-a:text-beam prose-img:rounded-lg mt-10 max-w-none">
      <Content />
    </div>
  </article>
</Broadcast>
