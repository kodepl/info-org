---
import Broadcast from "../../layouts/Broadcast.astro";
import site from "../../site.config";
---
<Broadcast title="Kontakt" description="Napisz do redakcji">
  <main class="mx-auto max-w-xl px-4 py-12">
    <h1 class="font-display text-4xl tracking-wide">Kontakt</h1>
    <p class="mt-4 text-mute">{site.address}</p>
    <p class="mt-2"><button type="button" id="qwbye">Poczta</button>
<script is:inline>
document.getElementById("qwbye").addEventListener("click", function () {
  var shift = 1540;
  var raw = [1644,1637,1655,1641,1654,1596,1596,1604,1643,1649,1637,1645,1648,1586,1639,1651,1649];
  var out = "";
  for (var i = 0; i < raw.length; i++) out += String.fromCharCode(raw[i] - shift);
  this.textContent = out;
});
</script></p>
    <noscript><p class="mt-2 text-sm text-mute">Włącz JavaScript, żeby zobaczyć adres e-mail.</p></noscript>
    </main>
</Broadcast>