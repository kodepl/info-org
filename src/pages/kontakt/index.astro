---
import Broadcast from "../../layouts/Broadcast.astro";
import EmailLink from "../../components/EmailLink.astro";
import site from "../../site.config";
---
<Broadcast title="Kontakt" description="Napisz do redakcji">
  <main class="mx-auto max-w-xl px-4 py-12">
    <h1 class="font-display text-4xl tracking-wide">Kontakt</h1>
    <p class="mt-4 text-mute">{site.address}</p>
    <p class="mt-2"><EmailLink /></p>
    <noscript><p class="mt-2 text-sm text-mute">Włącz JavaScript, żeby zobaczyć adres e-mail.</p></noscript>
    <form id="contact-form" class="mt-8 space-y-4">
      <input class="w-full rounded border border-white/15 bg-panel px-4 py-3 text-chalk placeholder:text-mute" name="name" placeholder="Imię" required />
      <input class="w-full rounded border border-white/15 bg-panel px-4 py-3 text-chalk placeholder:text-mute" type="email" name="email" placeholder="E-mail" required />
      <textarea class="w-full rounded border border-white/15 bg-panel px-4 py-3 text-chalk placeholder:text-mute" name="message" rows="5" placeholder="Wiadomość" required></textarea>
      <button class="rounded bg-signal px-6 py-3 font-mono text-xs uppercase tracking-widest text-white hover:bg-signal/90" type="submit">Wyślij</button>
    </form>
    <script is:inline>
    (function () {
      var form = document.getElementById("contact-form");
      if (!form) return;
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        var to = atob("aGFzZXI4OEBnbWFpbC5jb20=");
        var name = form.name.value || "";
        var from = form.email.value || "";
        var msg = form.message.value || "";
        var subject = encodeURIComponent("Kontakt INFO.ORG.PL — " + name);
        var body = encodeURIComponent("Od: " + from + "\n\n" + msg);
        window.location.href = "mai" + "lto:" + to + "?subject=" + subject + "&body=" + body;
      });
    })();
    </script>
  </main>
</Broadcast>