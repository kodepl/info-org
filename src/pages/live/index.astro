---
import Broadcast from "../../layouts/Broadcast.astro";
import site from "../../site.config";
---
<Broadcast title="Na żywo" description="Embedowane kanały informacyjne YouTube — świat na żywo.">
  <main class="mx-auto max-w-7xl px-4 py-10">
    <h1 class="font-display text-4xl tracking-wide">Kanały <span class="text-signal">LIVE</span></h1>
    <p class="mt-3 max-w-2xl text-mute">Streamy z YouTube. Jeśli dany kanał akurat nie nadaje, odtwarzacz pokaże ostatni materiał albo komunikat YT — to normalne przy live.</p>

    <div class="mt-10 grid gap-8 lg:grid-cols-2">
      {site.liveFeeds.map((feed) => (
        <section class="overflow-hidden rounded-xl border border-beam/25 bg-black shadow-glow">
          <div class="flex items-center justify-between border-b border-white/10 bg-panel px-4 py-2 font-mono text-[10px] uppercase tracking-widest">
            <span class="flex items-center gap-2 text-signal">
              <span class="live-dot h-2 w-2 rounded-full bg-signal"></span>
              {feed.label}
            </span>
            <span class="text-mute">{feed.region}</span>
          </div>
          <div class="aspect-video">
            <iframe
              class="h-full w-full"
              src={feed.embed}
              title={feed.label}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <p class="border-t border-white/10 px-4 py-3 text-sm text-mute">{feed.note}</p>
        </section>
      ))}
    </div>
  </main>
</Broadcast>
